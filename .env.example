# Copy to .env.local and fill in from your Supabase project:
#   Dashboard -> Project Settings -> API
#
# Both values below are publishable and safe in the browser — every table is
# behind Row Level Security. Never add the service-role key to this file or to
# any NEXT_PUBLIC_* variable; it bypasses RLS entirely.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# That is all. There is no service-role key and no auth configuration: login is
# two fixed usernames with no password, held in a cookie (src/lib/session.ts).
